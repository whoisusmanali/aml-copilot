# Copy to .env and adjust. Never commit .env.

# Postgres (raw data, cases, audit log, pgvector)
AML_POSTGRES_HOST=localhost
AML_POSTGRES_PORT=5432
AML_POSTGRES_DB=aml
AML_POSTGRES_USER=aml
AML_POSTGRES_PASSWORD=change-me-locally

# Redpanda (Kafka-compatible stream)
AML_KAFKA_BOOTSTRAP=localhost:19092

# Neo4j (entity graph)
AML_NEO4J_URI=bolt://localhost:7687
AML_NEO4J_USER=neo4j
AML_NEO4J_PASSWORD=change-me-locally

# Temporal (case workflow orchestration)
AML_TEMPORAL_HOST=localhost:7233

# MLflow (experiment tracking + model registry)
AML_MLFLOW_URI=http://localhost:5000

# Data
AML_DATA_DIR=./data
AML_RANDOM_SEED=42

# LLM (used from Step 4). Leave blank until then.
AML_LLM_PROVIDER=anthropic
AML_LLM_API_KEY=
