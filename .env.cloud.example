# Cloud environment. Copy to .env.cloud (git-ignored), fill in, then: make cloud-env
# The same values go into GitHub -> Settings -> Secrets for CI/CD.

# ---- Neon (managed Postgres: transactions, customers, cases, audit log) ----
# Neon console -> your project -> Connect. Use the *pooled* host for app traffic.
AML_POSTGRES_HOST=ep-xxxx-pooler.ca-central-1.aws.neon.tech
AML_POSTGRES_PORT=5432
AML_POSTGRES_DB=neondb
AML_POSTGRES_USER=neondb_owner
AML_POSTGRES_PASSWORD=
AML_POSTGRES_SSLMODE=require
# Direct (non-pooled) connection string, used only for schema migrations (DDL).
AML_POSTGRES_MIGRATE_URL=postgresql://neondb_owner:<password>@ep-xxxx.ca-central-1.aws.neon.tech/neondb?sslmode=require

# ---- Neo4j AuraDB Free (entity graph, Step 2) ----
AML_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
AML_NEO4J_USER=neo4j
AML_NEO4J_PASSWORD=

# ---- Services on the Oracle VM, reached over Tailscale ----
AML_VM_HOST=aml-vm
AML_KAFKA_BOOTSTRAP=aml-vm:19092
AML_TEMPORAL_HOST=aml-vm:7233
AML_MLFLOW_URI=http://aml-vm:5000

# Used only by docker-compose.cloud.yml on the VM
AML_OPS_DB_PASSWORD=
MLFLOW_S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.ca-toronto-1.oraclecloud.com
MLFLOW_BUCKET=aml-mlflow-artifacts
OCI_REGION=ca-toronto-1
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=

# ---- LLM (Step 4): Gemini free tier. Synthetic data only, never real customer data. ----
AML_LLM_PROVIDER=gemini
AML_LLM_API_KEY=

# ---- Observability (Steps 4 and 9) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
